            "value": "三行日曆"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض التطبيق أحداث التقويم القادمة في التطبيق والأدوات."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen viser dine kommende begivenheder i appen og dens widgets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 3-Zeilen-Kalender zeigt anstehende Termine in der App und ihren Widgets."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3-Line Calendar shows your upcoming calendar events in the app and its widgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario 3L muestra tus próximos eventos en la app y sus widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendrier 3L affiche vos prochains événements dans l’app et ses widgets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप आपके आगामी इवेंट ऐप और विजेट में दिखाता है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini menampilkan acara mendatang di aplikasi dan widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario 3L mostra i tuoi prossimi eventi nell’app e nei widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3行カレンダーはAppとウィジェットに今後の予定を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3줄 캘린더가 앱과 위젯에 다가오는 일정을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app toont je komende afspraken in de app en de widgets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja pokazuje nadchodzące wydarzenia w aplikacji i widżetach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Calendário 3L mostra seus próximos eventos no app e nos widgets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События календаря отображаются в приложении и виджетах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen visar dina kommande händelser i appen och dess widgetar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปแสดงกิจกรรมที่จะมาถึงในแอปและวิดเจ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, yaklaşan etkinlikleri uygulamada ve widget’larda gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng hiển thị sự kiện sắp tới trong ứng dụng và tiện ích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“三行日历”在App和小组件中显示您接下来的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「三行日曆」會在App和小工具中顯示您接下來的行程。"
          }
        }
      }
    },
