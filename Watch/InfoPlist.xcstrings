            "value": "ปฏิทิน 3 บรรทัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Satır Takvim"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch 3 dòng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三行日历"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三行日曆"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض التطبيق أحداث التقويم القادمة على واجهة الساعة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen viser dine kommende begivenheder på urskiven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der 3-Zeilen-Kalender zeigt anstehende Termine auf dem Zifferblatt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3-Line Calendar shows your upcoming calendar events on your watch face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario 3L muestra tus próximos eventos en la esfera del reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendrier 3L affiche vos prochains événements sur le cadran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप आपकी वॉच फ़ेस पर आगामी इवेंट दिखाता है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini menampilkan acara mendatang di permukaan jam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario 3L mostra i tuoi prossimi eventi sul quadrante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3行カレンダーは文字盤に今後の予定を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3줄 캘린더가 시계 페이스에 다가오는 일정을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app toont je komende afspraken op de wijzerplaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja pokazuje nadchodzące wydarzenia na tarczy zegarka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Calendário 3L mostra seus próximos eventos no mostrador do relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение показывает предстоящие события на циферблате."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen visar dina kommande händelser på urtavlan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปแสดงกิจกรรมที่จะมาถึงบนหน้าปัดนาฬิกา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama, yaklaşan etkinlikleri saat kadranında gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng hiển thị sự kiện sắp tới trên mặt đồng hồ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“三行日历”在表盘上显示您接下来的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「三行日曆」會在錶面顯示您接下來的行程。"
          }
        }
      }
    },
